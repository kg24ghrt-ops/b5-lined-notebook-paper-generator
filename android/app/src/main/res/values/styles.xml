<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NotebookPaper" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="buttonStyle">@style/Widget.NotebookPaper.Button</item>
    </style>

    <style name="Widget.NotebookPaper.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/button_ripple</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
    </style>

    <style name="Widget.NotebookPaper.Button.Destructive" parent="Widget.NotebookPaper.Button">
        <item name="android:background">@drawable/button_ripple_destructive</item>
        <item name="android:textColor">@color/color_on_destructive</item>
    </style>

    <style name="TextAppearance.NotebookPaper.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_background</item>
    </style>

    <style name="TextAppearance.NotebookPaper.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/color_on_background</item>
    </style>

    <style name="TextAppearance.NotebookPaper.Muted" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/color_muted_foreground</item>
    </style>
</resources>
